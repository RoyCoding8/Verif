{
  "name": "verity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "verity": "./src/cli.mjs"
  },
  "scripts": {
    "pretest": "npm run build:material",
    "test": "node --test test/*.test.mjs desktop/*.test.mjs",
    "demo": "node examples/run.mjs",
    "build:material": "node desktop/ui/material.mjs",
    "preapp": "npm run build:material",
    "app": "electron desktop/main.mjs",
    "presmoke": "npm run build:material",
    "smoke": "node desktop/smoke.mjs",
    "prepack:dir": "npm run build:material",
    "pack:dir": "electron-builder --dir --win --x64",
    "predist:win": "npm run build:material",
    "dist:win": "electron-builder --win nsis --x64",
    "dist": "npm run dist:win"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@material/web": "2.5.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.verity.desktop",
    "productName": "Verity",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "examples/**/*",
      "verification/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Verity-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Verity"
    }
  },
  "description": "Native desktop harness for Verity - turns approved software tasks into checked Git changes",
  "author": "Verity Team",
  "main": "desktop/main.mjs"
}
